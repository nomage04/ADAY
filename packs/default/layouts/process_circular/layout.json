{
  "id": "process_circular",
  "name": "Process Circular",
  "category": "smartart",
  "description": "Circular process or operating loop with four to six steps.",
  "renderer": {
    "type": "registered",
    "name": "process_circular"
  },
  "schema": {
    "required": [
      "title",
      "steps"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "steps": {
        "type": "array",
        "minItems": 3,
        "maxItems": 6,
        "items": {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "center": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
