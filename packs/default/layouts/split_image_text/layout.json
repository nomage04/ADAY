{
  "id": "split_image_text",
  "name": "Split Image Text",
  "category": "image",
  "description": "User photo on the left with concise supporting bullets on the right.",
  "renderer": {
    "type": "registered",
    "name": "split_image_text"
  },
  "schema": {
    "required": [
      "title",
      "image",
      "bullets"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "image": {
        "type": "string",
        "pattern": "^photo:[A-Za-z0-9_-]+$"
      },
      "bullets": {
        "type": "array",
        "minItems": 1,
        "maxItems": 7,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}
